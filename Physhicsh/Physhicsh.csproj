<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
	<OutputType>WinExe</OutputType>
	<ApplicationIcon>res\icon.ico</ApplicationIcon>

    <PublishAot>false</PublishAot>
	<PublishReadyToRun>false</PublishReadyToRun>
	<TieredCompilation>false</TieredCompilation>
	<PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="fonts\arial.ttf" />
    <None Remove="ui.lua" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="fonts\arial.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="res\icon.ico" />
    <Content Include="ui.lua">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aether.Physics2D" Version="2.2.0" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <PackageReference Include="Tomlyn" Version="2.10.2" />
  </ItemGroup>

</Project>
